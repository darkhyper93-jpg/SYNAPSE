{
  "name": "synapse",
  "version": "1.0.0",
  "private": true,
  "description": "SYNAPSE — adaptive cognitive challenge game (HTML/CSS/JS, no build step).",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -p 8080 -c-1 .",
    "test": "node tests/run.mjs",
    "lint": "eslint src tests",
    "build": "node scripts/build-web.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android": "npm run cap:sync && npx cap open android",
    "icons": "node scripts/make-icons.cjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "eslint": "10.1.0"
  }
}
